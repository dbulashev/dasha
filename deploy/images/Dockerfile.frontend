FROM --platform=$BUILDPLATFORM node:26-alpine AS builder
ARG BUILD_NUMBER=dev
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
ENV VITE_APP_VERSION=$BUILD_NUMBER
RUN npm run build-only

FROM nginx:alpine
# Patch OS-package CVEs from the base image without upgrading nginx itself.
RUN apk add --no-cache gettext && \
    apk add --no-cache --upgrade libxml2 libcrypto3 libssl3 libexpat libuuid && \
    sed -i '/^user  *nginx;/d' /etc/nginx/nginx.conf && \
    sed -i -E 's|^pid[[:space:]]+/[^;]*nginx\.pid;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf && \
    grep -qE '^pid[[:space:]]+/tmp/nginx\.pid;' /etc/nginx/nginx.conf
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/images/nginx.conf.template /etc/nginx/templates/nginx.conf.template
COPY deploy/images/mcp-location.conf.template /etc/nginx/templates/mcp-location.conf.template
COPY deploy/images/docker-entrypoint.sh /docker-entrypoint.sh
# The entrypoint renders configs into conf.d and nginx creates its temp dirs under
# /var/cache/nginx at startup. Group root + g+w on both keeps that working under any
# uid (OpenShift assigns a random one, gid is always 0), not only nginx's.
RUN rm -f /etc/nginx/conf.d/default.conf && \
    chown -R nginx:0 /etc/nginx /usr/share/nginx/html /docker-entrypoint.sh /var/cache/nginx && \
    chmod -R g+w /etc/nginx/conf.d /var/cache/nginx
USER nginx
EXPOSE 3000
ENTRYPOINT ["/docker-entrypoint.sh"]
